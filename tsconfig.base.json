{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@pos-architecture/session-contract": [
        "./libs/shared/session-contract/src/index.ts"
      ],
      "@pos-architecture/util-authorization": [
        "./libs/shared/util-authorization/src/index.ts"
      ],
      "@pos-architecture/auth": ["./libs/features/auth/src/index.ts"],
      "@pos-architecture/core": ["./libs/shared/core/src/index.ts"],
      "@pos-architecture/items": ["./libs/features/items/src/index.ts"],
      "@pos-architecture/inspections": [
        "./libs/features/inspections/src/index.ts"
      ],
      "@pos-architecture/util-common": [
        "./libs/shared/util-common/src/index.ts"
      ],
      "@pos-architecture/util-animations": [
        "./libs/shared/util-animations/src/index.ts"
      ],
      "@pos-architecture/util-theme": [
        "./libs/shared/util-theme/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
